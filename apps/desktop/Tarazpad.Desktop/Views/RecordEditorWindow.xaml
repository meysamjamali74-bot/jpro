<Window x:Class="Tarazpad.Desktop.Views.RecordEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ثبت اطلاعات" Width="560" MaxHeight="760" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F7FB">
    <Grid Margin="24" FlowDirection="RightToLeft">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="ثبت رکورد جدید" FontSize="21" FontWeight="Bold"/>
            <TextBlock x:Name="SubtitleText" Text="اطلاعات را تکمیل کنید." Foreground="#7B879A" FontSize="11" Margin="0,5,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#E3E8F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,18,0,0">
            <ScrollViewer MaxHeight="500" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="FieldsPanel"/>
            </ScrollViewer>
        </Border>
        <TextBlock Grid.Row="2" x:Name="ErrorText" Foreground="#D9363E" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" FlowDirection="LeftToRight" Margin="0,18,0,0">
            <Button Content="انصراف" Width="96" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
            <Button x:Name="SaveButton" Content="ذخیره" Width="112" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
