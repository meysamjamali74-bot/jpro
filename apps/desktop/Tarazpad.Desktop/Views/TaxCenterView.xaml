<UserControl x:Class="Tarazpad.Desktop.Views.TaxCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid FlowDirection="RightToLeft">
        <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="White" BorderBrush="#E6EBF2" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,7,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="پروفایل مالیاتی شرکت" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="اطلاعات پایه مورد استفاده در صورتحساب رسمی و سامانه مؤدیان" Foreground="#7E8A9C" FontSize="10" Margin="0,5,0,18"/>
                    <TextBlock Text="شناسه حافظه مالیاتی" FontWeight="SemiBold" FontSize="11"/><TextBox x:Name="MemoryBox" Margin="0,6,0,12" FlowDirection="LeftToRight"/>
                    <TextBlock Text="کد اقتصادی" FontWeight="SemiBold" FontSize="11"/><TextBox x:Name="EconomicBox" Margin="0,6,0,12" FlowDirection="LeftToRight"/>
                    <TextBlock Text="شناسه ملی" FontWeight="SemiBold" FontSize="11"/><TextBox x:Name="NationalBox" Margin="0,6,0,12" FlowDirection="LeftToRight"/>
                    <TextBlock Text="کد پستی" FontWeight="SemiBold" FontSize="11"/><TextBox x:Name="PostalBox" Margin="0,6,0,12" FlowDirection="LeftToRight"/>
                    <TextBlock Text="شناسه پایانه" FontWeight="SemiBold" FontSize="11"/><TextBox x:Name="TerminalBox" Margin="0,6,0,12" FlowDirection="LeftToRight"/>
                    <TextBlock Text="آدرس" FontWeight="SemiBold" FontSize="11"/><TextBox x:Name="AddressBox" Height="68" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,6,0,12"/>
                    <TextBlock Text="نوع پیش‌فرض صورتحساب" FontWeight="SemiBold" FontSize="11"/>
                    <ComboBox x:Name="InvoiceTypeBox" Height="38" Margin="0,6,0,12"><ComboBoxItem Content="TYPE_1"/><ComboBoxItem Content="TYPE_2"/></ComboBox>
                    <CheckBox x:Name="EnabledBox" Content="سامانه مؤدیان برای شرکت فعال است" Margin="0,4,0,16"/>
                    <Button x:Name="SaveButton" Content="ذخیره پروفایل مالیاتی" Height="42" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click"/>
                    <TextBlock x:Name="ProfileStatus" Text="" TextWrapping="Wrap" FontSize="10" Margin="0,9,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1" Background="White" BorderBrush="#E6EBF2" BorderThickness="1" CornerRadius="12" Padding="18" Margin="7,0,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="نرخ‌های مالیاتی" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="نرخ‌های فعال و دوره اعتبار آن‌ها" Foreground="#7E8A9C" FontSize="10" Margin="0,5,0,13"/>
                </StackPanel>
                <DataGrid Grid.Row="1" x:Name="RatesGrid" AutoGenerateColumns="True" IsReadOnly="True" AutoGeneratingColumn="RatesGrid_AutoGeneratingColumn" AlternatingRowBackground="#FBFCFE"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
