<Window x:Class="Tarazpad.Desktop.Views.PurchaseInvoiceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="فاکتور خرید جدید" Width="1220" Height="790" MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterOwner" Background="#F5F7FB" FlowDirection="RightToLeft">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="15">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.15*"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="ثبت فاکتور خرید" FontSize="19" FontWeight="Bold"/><TextBlock Text="  •  مبالغ به ریال" Foreground="#718096" FontSize="10" VerticalAlignment="Center"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,0"><TextBlock Text="تأمین‌کننده *" FontSize="10" Foreground="#64748B"/><ComboBox x:Name="SupplierBox" Height="37" Margin="0,5,0,0" DisplayMemberPath="Display" SelectionChanged="SupplierBox_SelectionChanged"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0"><TextBlock Text="سفارش خرید" FontSize="10" Foreground="#64748B"/><ComboBox x:Name="PurchaseOrderBox" Height="37" Margin="0,5,0,0" DisplayMemberPath="Display" SelectionChanged="PurchaseOrderBox_SelectionChanged"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="6,0"><TextBlock Text="رسید انبار" FontSize="10" Foreground="#64748B"/><ComboBox x:Name="GoodsReceiptBox" Height="37" Margin="0,5,0,0" DisplayMemberPath="Display" SelectionChanged="GoodsReceiptBox_SelectionChanged"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="3" Margin="6,0"><TextBlock Text="تاریخ فاکتور *" FontSize="10" Foreground="#64748B"/><TextBox x:Name="InvoiceDateBox" Height="37" Margin="0,5,0,0" FlowDirection="LeftToRight"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="4" Margin="6,0,0,0"><TextBlock Text="سررسید" FontSize="10" Foreground="#64748B"/><TextBox x:Name="DueDateBox" Height="37" Margin="0,5,0,0" FlowDirection="LeftToRight"/></StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,10,6,0"><TextBlock Text="شماره فاکتور تأمین‌کننده" FontSize="10" Foreground="#64748B"/><TextBox x:Name="SupplierInvoiceNoBox" Height="37" Margin="0,5,0,0"/></StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="6,10,0,0"><TextBlock Text="نوع خرید" FontSize="10" Foreground="#64748B"/><ComboBox x:Name="PurchaseKindBox" Height="37" Margin="0,5,0,0"><ComboBoxItem Tag="GOODS" Content="کالا" IsSelected="True"/><ComboBoxItem Tag="SERVICE" Content="خدمت"/><ComboBoxItem Tag="EXPENSE" Content="هزینه"/></ComboBox></StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="6,10,0,0"><TextBlock Text="نوع سند" FontSize="10" Foreground="#64748B"/><ComboBox x:Name="ClassificationBox" Height="37" Margin="0,5,0,0" SelectionChanged="ClassificationBox_SelectionChanged"><ComboBoxItem Tag="NON_OFFICIAL" Content="غیررسمی" IsSelected="True"/><ComboBoxItem Tag="OFFICIAL" Content="رسمی"/></ComboBox></StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="3" Margin="6,10,0,0"><TextBlock Text="نوع صورتحساب مالیاتی" FontSize="10" Foreground="#64748B"/><ComboBox x:Name="TaxTypeBox" Height="37" Margin="0,5,0,0" IsEnabled="False"><ComboBoxItem Tag="TYPE_1" Content="نوع اول" IsSelected="True"/><ComboBoxItem Tag="TYPE_2" Content="نوع دوم"/><ComboBoxItem Tag="NON_ELECTRONIC" Content="غیرالکترونیکی"/></ComboBox></StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="4" Margin="6,10,0,0"><TextBlock Text="شماره منحصر‌به‌فرد مالیاتی" FontSize="10" Foreground="#64748B"/><TextBox x:Name="TaxUniqueNoBox" Height="37" Margin="0,5,0,0" IsEnabled="False" FlowDirection="LeftToRight"/></StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,10,0,10">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,6,0"><TextBlock Text="نوع تسویه" FontSize="10" Foreground="#64748B"/><ComboBox x:Name="SettlementBox" Height="36" Margin="0,5,0,0"><ComboBoxItem Tag="CREDIT" Content="اعتباری" IsSelected="True"/><ComboBoxItem Tag="CASH" Content="نقدی"/><ComboBoxItem Tag="MIXED" Content="ترکیبی"/></ComboBox></StackPanel>
                <StackPanel Grid.Column="1" Margin="6,0"><TextBlock Text="وضعیت اتصال خرید" FontSize="10" Foreground="#64748B"/><TextBlock x:Name="ContextText" Text="بدون اتصال سفارش/رسید" Margin="0,12,0,0" FontWeight="SemiBold" Foreground="#64748B"/></StackPanel>
                <StackPanel Grid.Column="2" Margin="6,0,0,0"><TextBlock Text="یادداشت" FontSize="10" Foreground="#64748B"/><TextBox x:Name="NotesBox" Height="36" Margin="0,5,0,0"/></StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="335"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,6,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <TextBlock Text="افزودن ردیف خرید" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBlock Text="کالا / خدمت *" FontSize="10" Foreground="#64748B"/><ComboBox x:Name="ProductBox" Height="38" Margin="0,5,0,8" DisplayMemberPath="Display" SelectionChanged="ProductBox_SelectionChanged"/>
                    <TextBlock x:Name="MatchHintText" Text="" Foreground="#64748B" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,5,0"><TextBlock Text="مقدار *" FontSize="10" Foreground="#64748B"/><TextBox x:Name="QtyBox" Text="1" Height="36" Margin="0,5,0,10" FlowDirection="LeftToRight"/></StackPanel><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="قیمت واحد *" FontSize="10" Foreground="#64748B"/><TextBox x:Name="PriceBox" Text="0" Height="36" Margin="0,5,0,10" FlowDirection="LeftToRight"/></StackPanel></Grid>
                    <TextBlock Text="تخفیف ردیف" FontSize="10" Foreground="#64748B"/><TextBox x:Name="DiscountBox" Text="0" Height="36" Margin="0,5,0,10" FlowDirection="LeftToRight"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,5,0"><TextBlock Text="وضعیت مالیات" FontSize="10" Foreground="#64748B"/><ComboBox x:Name="VatStatusBox" Height="36" Margin="0,5,0,10"><ComboBoxItem Tag="STANDARD" Content="مشمول" IsSelected="True"/><ComboBoxItem Tag="EXEMPT" Content="معاف"/><ComboBoxItem Tag="ZERO" Content="نرخ صفر"/></ComboBox></StackPanel><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="نرخ VAT %" FontSize="10" Foreground="#64748B"/><TextBox x:Name="VatRateBox" Text="0" Height="36" Margin="0,5,0,10" FlowDirection="LeftToRight"/></StackPanel></Grid>
                    <TextBlock Text="عوارض و وجوه قانونی" FontSize="10" Foreground="#64748B"/><TextBox x:Name="DutiesBox" Text="0" Height="36" Margin="0,5,0,10" FlowDirection="LeftToRight"/>
                    <TextBlock Text="شرح ردیف" FontSize="10" Foreground="#64748B"/><TextBox x:Name="LineDescriptionBox" Height="36" Margin="0,5,0,12"/>
                    <Button Content="+ افزودن ردیف" Height="40" Style="{StaticResource PrimaryButton}" Click="AddLine_Click"/><Button Content="حذف ردیف انتخاب‌شده" Height="38" Margin="0,8,0,0" Style="{StaticResource SecondaryButton}" Click="RemoveLine_Click"/>
                </StackPanel></ScrollViewer>
            </Border>
            <Grid Grid.Column="1" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="1"><DataGrid x:Name="LinesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" AlternatingRowBackground="#FBFCFE"><DataGrid.Columns><DataGridTextColumn Header="کد" Binding="{Binding Sku}" Width="90"/><DataGridTextColumn Header="کالا / خدمت" Binding="{Binding ProductName}" Width="*" MinWidth="160"/><DataGridTextColumn Header="مقدار" Binding="{Binding Qty, StringFormat=N2}" Width="80"/><DataGridTextColumn Header="قیمت واحد" Binding="{Binding UnitPrice, StringFormat=N0}" Width="105"/><DataGridTextColumn Header="تخفیف" Binding="{Binding DiscountAmount, StringFormat=N0}" Width="90"/><DataGridTextColumn Header="مالیات" Binding="{Binding Tax, StringFormat=N0}" Width="90"/><DataGridTextColumn Header="عوارض" Binding="{Binding OtherDutiesAmount, StringFormat=N0}" Width="85"/><DataGridTextColumn Header="جمع ردیف" Binding="{Binding Total, StringFormat=N0}" Width="115"/></DataGrid.Columns></DataGrid></Border>
                <Border Grid.Row="1" Background="#0E2A4A" CornerRadius="11" Padding="14" Margin="0,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ناخالص" Foreground="#9DB3CC" FontSize="9"/><TextBlock x:Name="GrossText" Text="0" Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="تخفیف" Foreground="#9DB3CC" FontSize="9"/><TextBlock x:Name="DiscountText" Text="0" Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="مالیات" Foreground="#9DB3CC" FontSize="9"/><TextBlock x:Name="TaxText" Text="0" Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="عوارض" Foreground="#9DB3CC" FontSize="9"/><TextBlock x:Name="DutiesText" Text="0" Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="خالص فاکتور" Foreground="#9DB3CC" FontSize="9"/><TextBlock x:Name="NetText" Text="0" Foreground="White" FontSize="17" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Grid></Border>
            </Grid>
        </Grid>
        <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ErrorText" Foreground="#D9363E" TextWrapping="Wrap" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" FlowDirection="LeftToRight"><Button Content="انصراف" Width="96" Style="{StaticResource SecondaryButton}" IsCancel="True"/><Button x:Name="SaveButton" Content="ذخیره فاکتور" Width="125" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></StackPanel></Grid>
    </Grid>
</Window>
