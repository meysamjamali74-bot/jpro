<Window x:Class="Tarazpad.Desktop.Views.InvoiceDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="جزئیات سند" Width="980" Height="650" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterOwner" Background="#F5F7FB" FlowDirection="RightToLeft">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Text="جزئیات سند" FontSize="19" FontWeight="Bold"/>
                <TextBlock x:Name="MetaText" Text="" Foreground="#64748B" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="1" Margin="0,10,0,0">
            <DataGrid x:Name="LinesGrid" AutoGenerateColumns="True" IsReadOnly="True" AlternatingRowBackground="#FBFCFE" AutoGeneratingColumn="Grid_AutoGeneratingColumn"/>
        </Border>
        <Border Grid.Row="2" x:Name="MatchesBorder" Background="#FFF9F1" BorderBrush="#F5D6A0" BorderThickness="1" CornerRadius="10" Padding="1" Margin="0,10,0,0" Visibility="Collapsed">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="130"/></Grid.RowDefinitions>
                <TextBlock Text="مغایرت‌های تطبیق خرید" FontWeight="Bold" Margin="12,9"/>
                <DataGrid Grid.Row="1" x:Name="MatchesGrid" AutoGenerateColumns="True" IsReadOnly="True" AutoGeneratingColumn="Grid_AutoGeneratingColumn"/>
            </Grid>
        </Border>
        <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Foreground="#64748B" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="بستن" Width="92" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
