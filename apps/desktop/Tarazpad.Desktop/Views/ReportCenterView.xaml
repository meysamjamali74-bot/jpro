<UserControl x:Class="Tarazpad.Desktop.Views.ReportCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid FlowDirection="RightToLeft">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#E6EBF2" BorderThickness="1" CornerRadius="12" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="گزارش" Foreground="#64748B" FontSize="10" Margin="0,0,0,6"/>
                    <ComboBox x:Name="ReportTypeBox" Height="38" SelectionChanged="ReportTypeBox_SelectionChanged">
                        <ComboBoxItem Tag="TRIAL_BALANCE" Content="تراز آزمایشی"/>
                        <ComboBoxItem Tag="PROFIT_LOSS" Content="سود و زیان"/>
                        <ComboBoxItem Tag="BALANCE_SHEET" Content="ترازنامه"/>
                        <ComboBoxItem Tag="CASH_FLOW" Content="جریان وجوه نقد"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0">
                    <TextBlock Text="از تاریخ (شمسی)" Foreground="#64748B" FontSize="10" Margin="0,0,0,6"/>
                    <TextBox x:Name="FromBox" Height="38" FlowDirection="LeftToRight"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="8,0">
                    <TextBlock x:Name="ToLabel" Text="تا تاریخ (شمسی)" Foreground="#64748B" FontSize="10" Margin="0,0,0,6"/>
                    <TextBox x:Name="ToBox" Height="38" FlowDirection="LeftToRight"/>
                </StackPanel>
                <Button Grid.Column="3" x:Name="RunButton" Content="اجرای گزارش" Width="126" Height="40" Margin="14,18,0,0" Style="{StaticResource PrimaryButton}" Click="RunButton_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#E6EBF2" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,6,0"><StackPanel><TextBlock x:Name="Summary1Label" Text="شاخص ۱" Foreground="#7A8798" FontSize="10"/><TextBlock x:Name="Summary1" Text="—" FontSize="17" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel></Border>
            <Border Grid.Column="1" Background="White" BorderBrush="#E6EBF2" BorderThickness="1" CornerRadius="10" Padding="14" Margin="6,0"><StackPanel><TextBlock x:Name="Summary2Label" Text="شاخص ۲" Foreground="#7A8798" FontSize="10"/><TextBlock x:Name="Summary2" Text="—" FontSize="17" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel></Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#E6EBF2" BorderThickness="1" CornerRadius="10" Padding="14" Margin="6,0"><StackPanel><TextBlock x:Name="Summary3Label" Text="شاخص ۳" Foreground="#7A8798" FontSize="10"/><TextBlock x:Name="Summary3" Text="—" FontSize="17" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel></Border>
            <Border Grid.Column="3" Background="White" BorderBrush="#E6EBF2" BorderThickness="1" CornerRadius="10" Padding="14" Margin="6,0,0,0"><StackPanel><TextBlock x:Name="Summary4Label" Text="شاخص ۴" Foreground="#7A8798" FontSize="10"/><TextBlock x:Name="Summary4" Text="—" FontSize="17" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel></Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#E6EBF2" BorderThickness="1" CornerRadius="12" Padding="1">
            <Grid>
                <DataGrid x:Name="ReportGrid" AutoGenerateColumns="True" IsReadOnly="True" AutoGeneratingColumn="ReportGrid_AutoGeneratingColumn" AlternatingRowBackground="#FBFCFE"/>
                <Border x:Name="LoadingPanel" Background="#ECFFFFFF" Visibility="Collapsed" CornerRadius="11"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><ProgressBar Width="180" Height="5" IsIndeterminate="True"/><TextBlock Text="در حال محاسبه گزارش..." Foreground="#64748B" FontSize="11" Margin="0,12,0,0"/></StackPanel></Border>
                <TextBlock x:Name="ErrorText" Text="" Foreground="#D9363E" Background="#FFF7F7" TextWrapping="Wrap" VerticalAlignment="Top" Margin="14" Padding="10" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
