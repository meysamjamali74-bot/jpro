<Window x:Class="Tarazpad.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ترازپاد 2.0" Width="1450" Height="900" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}">
    <Grid FlowDirection="RightToLeft">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#17395E" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="18,20,18,16">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="45" Height="45" CornerRadius="13" Background="#1E5EFF">
                            <TextBlock Text="ت" Foreground="White" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,1,0,0">
                            <TextBlock Text="ترازپاد" Foreground="White" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Enterprise Desktop 2.0" Foreground="#829BB7" FontSize="10" FlowDirection="LeftToRight"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Height="1" Background="#1A3B61" Margin="0,18,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,0,8,12">
                        <TextBlock Text="مدیریت" Foreground="#6887A7" FontSize="10" Margin="15,3,15,6"/>
                        <Button Content="◈  داشبورد مدیریتی" Tag="dashboard" Style="{StaticResource NavButton}" Click="NavButton_Click"/>
                        <Button Content="▦  کارتابل و وظایف" Tag="tasks" Style="{StaticResource NavButton}" Click="NavButton_Click"/>

                        <TextBlock Text="مالی و حسابداری" Foreground="#6887A7" FontSize="10" Margin="15,16,15,6"/>
                        <Button Content="▤  حسابداری و اسناد" Tag="accounting" Style="{StaticResource NavButton}" Click="NavButton_Click"/>
                        <Button Content="●  خزانه‌داری" Tag="treasury" Style="{StaticResource NavButton}" Click="NavButton_Click"/>
                        <Button Content="◫  دریافت و پرداخت" Tag="cashflow" Style="{StaticResource NavButton}" Click="NavButton_Click"/>
                        <Button Content="▥  دارایی ثابت" Tag="assets" Style="{StaticResource NavButton}" Click="NavButton_Click"/>
                        <Button Content="٪  مالیات و سامانه مودیان" Tag="tax" Style="{StaticResource NavButton}" Click="NavButton_Click"/>

                        <TextBlock Text="بازرگانی و عملیات" Foreground="#6887A7" FontSize="10" Margin="15,16,15,6"/>
                        <Button Content="◉  فروش" Tag="sales" Style="{StaticResource NavButton}" Click="NavButton_Click"/>
                        <Button Content="◆  خرید و تأمین" Tag="purchases" Style="{StaticResource NavButton}" Click="NavButton_Click"/>
                        <Button Content="▣  کالا و انبار" Tag="inventory" Style="{StaticResource NavButton}" Click="NavButton_Click"/>
                        <Button Content="⇄  لجستیک و توزیع" Tag="logistics" Style="{StaticResource NavButton}" Click="NavButton_Click"/>
                        <Button Content="◎  اشخاص" Tag="parties" Style="{StaticResource NavButton}" Click="NavButton_Click"/>
                        <Button Content="♙  باشگاه مشتریان" Tag="crm" Style="{StaticResource NavButton}" Click="NavButton_Click"/>

                        <TextBlock Text="سازمانی" Foreground="#6887A7" FontSize="10" Margin="15,16,15,6"/>
                        <Button Content="♟  منابع انسانی و حقوق" Tag="hr" Style="{StaticResource NavButton}" Click="NavButton_Click"/>
                        <Button Content="▧  گزارش‌ها و تحلیل" Tag="reports" Style="{StaticResource NavButton}" Click="NavButton_Click"/>
                        <Button Content="⚙  تنظیمات و دسترسی" Tag="settings" Style="{StaticResource NavButton}" Click="NavButton_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Background="#0E2744" Padding="14" Margin="10" CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock x:Name="UserText" Text="کاربر" Foreground="White" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,7,0,0">
                            <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ServerText" Foreground="#92A9C2" FontSize="9" Text="سرور داخلی" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" Width="190"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="68"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <Border Background="White" BorderBrush="#E6EBF2" BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="داشبورد مدیریتی" FontSize="20" FontWeight="Bold" Foreground="#182235"/>
                        <TextBlock x:Name="PageSubtitle" Text="نمای یکپارچه وضعیت مالی و عملیاتی" FontSize="11" Foreground="#8290A5" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight">
                        <Button Content="⟳" ToolTip="بازخوانی" Width="38" Height="38" Style="{StaticResource SecondaryButton}" Padding="0" Click="RefreshButton_Click"/>
                        <Button Content="خروج" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="LogoutButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="22">
                <ContentControl x:Name="ContentHost"/>
            </Grid>

            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E6EBF2" BorderThickness="0,1,0,0">
                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusBarText" Text="آماده" Foreground="#64748B" FontSize="10" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Tarazpad Native • WPF x64 • MySQL/LAN" Foreground="#94A3B8" FontSize="9" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
