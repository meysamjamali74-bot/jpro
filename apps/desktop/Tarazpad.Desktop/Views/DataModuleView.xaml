<UserControl x:Class="Tarazpad.Desktop.Views.DataModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid FlowDirection="RightToLeft">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="#E6EBF2" BorderThickness="1" CornerRadius="12" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="HeadingText" Text="ماژول" FontSize="17" FontWeight="Bold"/>
                    <TextBlock x:Name="DescriptionText" Foreground="#7B8798" FontSize="11" Margin="0,6,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#EEF4FF" CornerRadius="8" Padding="12,7" VerticalAlignment="Center">
                    <TextBlock x:Name="CountText" Text="0 رکورد" Foreground="#31558E" FontWeight="SemiBold" FontSize="11"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SearchBox" Width="310" Height="39" ToolTip="جست‌وجو" KeyDown="SearchBox_KeyDown"/>
                <Button x:Name="SearchButton" Content="جست‌وجو" Margin="7,0,0,0" Style="{StaticResource SecondaryButton}" Click="SearchButton_Click"/>
                <Button Content="بازخوانی" Margin="7,0,0,0" Style="{StaticResource SecondaryButton}" Click="Refresh_Click"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" FlowDirection="LeftToRight">
                <Button Content="خروجی CSV" Style="{StaticResource SecondaryButton}" Click="Export_Click"/>
                <Button x:Name="AddButton" Content="+ ثبت جدید" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Click="Add_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#E6EBF2" BorderThickness="1" CornerRadius="12" Padding="1">
            <Grid>
                <DataGrid x:Name="Grid" AutoGenerateColumns="True" IsReadOnly="True" AutoGeneratingColumn="Grid_AutoGeneratingColumn"
                          SelectionChanged="Grid_SelectionChanged" AlternatingRowBackground="#FBFCFE"/>
                <Border x:Name="EmptyPanel" Background="#FAFCFF" Visibility="Collapsed" CornerRadius="11">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="◇" FontSize="34" Foreground="#AAB7C8" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyText" Text="داده‌ای وجود ندارد" FontSize="13" Foreground="#718096" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border x:Name="LoadingPanel" Background="#ECFFFFFF" Visibility="Collapsed" CornerRadius="11">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="180" Height="5" IsIndeterminate="True"/>
                        <TextBlock Text="در حال دریافت اطلاعات..." Foreground="#64748B" FontSize="11" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="4,9,4,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterText" Text="" Foreground="#7F8B9B" FontSize="10"/>
            <TextBlock Grid.Column="1" x:Name="SelectionText" Text="" Foreground="#64748B" FontSize="10"/>
        </Grid>
    </Grid>
</UserControl>
