<UserControl x:Class="Tarazpad.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel FlowDirection="RightToLeft">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" BorderBrush="#E6EBF2" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,7,0">
                    <StackPanel><TextBlock Text="فروش امروز" Foreground="#748197" FontSize="11"/><TextBlock x:Name="SalesTodayText" Text="—" FontSize="22" FontWeight="Bold" Margin="0,9,0,0"/><TextBlock Text="ریال" Foreground="#94A3B8" FontSize="10" Margin="0,5,0,0"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Background="White" BorderBrush="#E6EBF2" BorderThickness="1" CornerRadius="12" Padding="18" Margin="7,0">
                    <StackPanel><TextBlock Text="فروش ماه" Foreground="#748197" FontSize="11"/><TextBlock x:Name="SalesMonthText" Text="—" FontSize="22" FontWeight="Bold" Margin="0,9,0,0"/><TextBlock Text="ریال" Foreground="#94A3B8" FontSize="10" Margin="0,5,0,0"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Background="White" BorderBrush="#E6EBF2" BorderThickness="1" CornerRadius="12" Padding="18" Margin="7,0">
                    <StackPanel><TextBlock Text="مطالبات باز" Foreground="#748197" FontSize="11"/><TextBlock x:Name="ArOpenText" Text="—" FontSize="22" FontWeight="Bold" Margin="0,9,0,0"/><TextBlock Text="ریال" Foreground="#94A3B8" FontSize="10" Margin="0,5,0,0"/></StackPanel>
                </Border>
                <Border Grid.Column="3" Background="White" BorderBrush="#E6EBF2" BorderThickness="1" CornerRadius="12" Padding="18" Margin="7,0,0,0">
                    <StackPanel><TextBlock Text="ارزش موجودی" Foreground="#748197" FontSize="11"/><TextBlock x:Name="InventoryText" Text="—" FontSize="22" FontWeight="Bold" Margin="0,9,0,0"/><TextBlock Text="ریال" Foreground="#94A3B8" FontSize="10" Margin="0,5,0,0"/></StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="0.65*"/></Grid.ColumnDefinitions>
                <Border Background="White" BorderBrush="#E6EBF2" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,7,0">
                    <StackPanel>
                        <TextBlock Text="مرکز کنترل مالی" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="شاخص‌هایی که مدیر مالی باید هر روز کنترل کند" Foreground="#7D899B" FontSize="11" Margin="0,6,0,18"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Background="#F7F9FC" CornerRadius="9" Padding="16" Margin="0,0,6,0"><StackPanel><TextBlock Text="مطالبات سررسید گذشته" Foreground="#7A8798" FontSize="10"/><TextBlock x:Name="ArOverdueText" Text="—" FontSize="17" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
                            <Border Grid.Column="1" Background="#F7F9FC" CornerRadius="9" Padding="16" Margin="6,0"><StackPanel><TextBlock Text="موقعیت نقدینگی" Foreground="#7A8798" FontSize="10"/><TextBlock x:Name="CashPositionText" Text="—" FontSize="17" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
                            <Border Grid.Column="2" Background="#F7F9FC" CornerRadius="9" Padding="16" Margin="6,0,0,0"><StackPanel><TextBlock Text="وظایف باز" Foreground="#7A8798" FontSize="10"/><TextBlock x:Name="TasksText" Text="—" FontSize="17" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
                        </Grid>
                        <Border Background="#EEF4FF" CornerRadius="10" Padding="16" Margin="0,16,0,0">
                            <TextBlock Text="قاعده کنترل: مانده مطالبات، بانک و صندوق، اسناد ثبت‌نشده، کسری/اضافه انبار، چک‌های نزدیک سررسید و خطاهای مالیاتی باید در کارتابل روزانه قابل پیگیری باشند." TextWrapping="Wrap" Foreground="#31558E" LineHeight="22" FontSize="11"/>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#0E2A4A" CornerRadius="12" Padding="22" Margin="7,0,0,0">
                    <StackPanel>
                        <TextBlock Text="کنترل عملیات" Foreground="White" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="رزرو کالا" Foreground="#9CB3CD" FontSize="10" Margin="0,20,0,0"/><TextBlock x:Name="ReservedText" Text="—" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/>
                        <TextBlock Text="سفرهای امروز" Foreground="#9CB3CD" FontSize="10" Margin="0,18,0,0"/><TextBlock x:Name="TripsText" Text="—" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/>
                        <TextBlock Text="در مسیر" Foreground="#9CB3CD" FontSize="10" Margin="0,18,0,0"/><TextBlock x:Name="TripsRouteText" Text="—" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="White" BorderBrush="#E6EBF2" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="وضعیت اتصال و داده" FontSize="14" FontWeight="Bold"/><TextBlock x:Name="LastRefreshText" Text="" Foreground="#8491A4" FontSize="10" Margin="0,5,0,0"/></StackPanel>
                    <TextBlock Grid.Column="1" x:Name="HealthText" Text="● متصل" Foreground="#0F9D68" FontWeight="Bold" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
