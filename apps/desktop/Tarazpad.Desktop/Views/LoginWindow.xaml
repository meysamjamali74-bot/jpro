<Window x:Class="Tarazpad.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ترازپاد - ورود" Height="650" Width="1040" WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize" Background="#09182D">
    <Grid FlowDirection="RightToLeft">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="0.95*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="54">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <Border Width="76" Height="76" CornerRadius="22" Background="#1E5EFF" HorizontalAlignment="Right">
                    <TextBlock Text="ت" Foreground="White" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="ترازپاد" Foreground="White" FontSize="32" FontWeight="Bold" Margin="0,22,0,0"/>
                <TextBlock Text="سامانه یکپارچه مالی، بازرگانی و عملیات" Foreground="#9FB3CC" FontSize="15" Margin="0,8,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="نسخه دسکتاپ ویندوز" Foreground="#5D8DFF" FontSize="15" FontWeight="Bold"/>
                <TextBlock Text="بدون نیاز به مرورگر" Foreground="White" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                <TextBlock Text="اتصال امن به سرور داخلی و MySQL، مناسب اجرای چندکاربره در شبکه سازمان." Foreground="#B5C5D8" FontSize="14" TextWrapping="Wrap" LineHeight="26" Margin="0,15,0,0" Width="390" HorizontalAlignment="Right"/>

                <Grid Margin="0,26,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Background="#102845" CornerRadius="10" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="Native" Foreground="White" FontWeight="Bold"/><TextBlock Text="WPF x64" Foreground="#91A8C2" Margin="0,6,0,0"/></StackPanel></Border>
                    <Border Grid.Column="1" Background="#102845" CornerRadius="10" Padding="14" Margin="8,0"><StackPanel><TextBlock Text="LAN" Foreground="White" FontWeight="Bold"/><TextBlock Text="چندکاربره" Foreground="#91A8C2" Margin="0,6,0,0"/></StackPanel></Border>
                    <Border Grid.Column="2" Background="#102845" CornerRadius="10" Padding="14" Margin="8,0,0,0"><StackPanel><TextBlock Text="MySQL" Foreground="White" FontWeight="Bold"/><TextBlock Text="دیتابیس داخلی" Foreground="#91A8C2" Margin="0,6,0,0"/></StackPanel></Border>
                </Grid>
            </StackPanel>

            <TextBlock Grid.Row="2" Text="Tarazpad Enterprise Desktop 2.0" Foreground="#657C98" FontSize="11"/>
        </Grid>

        <Border Grid.Column="1" Background="#F7F9FC" CornerRadius="28,0,0,28">
            <Grid Margin="58">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ورود به ترازپاد" FontSize="27" FontWeight="Bold" Foreground="#172033"/>
                    <TextBlock Text="برای ادامه، اطلاعات کاربری سازمان را وارد کنید." FontSize="13" Foreground="#718096" Margin="0,9,0,28"/>

                    <TextBlock Text="آدرس سرور" Foreground="#445166" FontWeight="SemiBold" Margin="0,0,0,7"/>
                    <TextBox x:Name="ServerBox" Height="42" FlowDirection="LeftToRight" HorizontalContentAlignment="Left"/>
                    <TextBlock Text="نمونه: http://192.168.1.10:8080" Foreground="#94A3B8" FontSize="11" Margin="0,6,0,18"/>

                    <TextBlock Text="نام کاربری / ایمیل" Foreground="#445166" FontWeight="SemiBold" Margin="0,0,0,7"/>
                    <TextBox x:Name="EmailBox" Height="42" FlowDirection="LeftToRight" HorizontalContentAlignment="Left"/>

                    <TextBlock Text="رمز عبور" Foreground="#445166" FontWeight="SemiBold" Margin="0,18,0,7"/>
                    <PasswordBox x:Name="PasswordBox" Height="42" FlowDirection="LeftToRight"/>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <CheckBox x:Name="RememberServerBox" Content="ذخیره آدرس سرور" VerticalAlignment="Center" Foreground="#64748B"/>
                        <Button Grid.Column="1" x:Name="TestButton" Content="تست اتصال" Style="{StaticResource SecondaryButton}" Click="TestButton_Click"/>
                    </Grid>

                    <Button x:Name="LoginButton" Content="ورود به نرم‌افزار" Height="47" Margin="0,22,0,0" Style="{StaticResource PrimaryButton}" Click="LoginButton_Click" IsDefault="True"/>
                    <TextBlock x:Name="StatusText" Text="" Foreground="#D9363E" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
