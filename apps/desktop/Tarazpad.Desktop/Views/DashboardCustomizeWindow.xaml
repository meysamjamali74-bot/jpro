<Window x:Class="Tarazpad.Desktop.Views.DashboardCustomizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="شخصی‌سازی داشبورد" Width="480" Height="620" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#F5F7FA" FlowDirection="RightToLeft">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="انتخاب ویجت‌های مدیریتی" FontSize="19" FontWeight="Bold" Foreground="#102A43"/>
            <TextBlock Text="شاخص‌هایی را که می‌خواهید در صفحه اصلی ببینید فعال کنید. ترتیب آن‌ها بعداً با Drag &amp; Drop روی خود داشبورد قابل تغییر است." TextWrapping="Wrap" Foreground="#718096" FontSize="11" LineHeight="20" Margin="0,8,0,14"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="انتخاب همه" Click="SelectAll_Click" Padding="12,7" Margin="0,0,8,0"/>
                <Button Content="حذف انتخاب‌ها" Click="ClearAll_Click" Padding="12,7"/>
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,16,0,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Options}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#EDF2F7" BorderThickness="0,0,0,1" Padding="8,11">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" FontSize="12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#23364D"/>
                                        <TextBlock Text="{Binding Unit}" Foreground="#94A3B8" FontSize="10" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="ذخیره" Click="Save_Click" Width="105" Padding="12,9" Background="#0E2A4A" Foreground="White" BorderThickness="0" Margin="0,0,8,0"/>
            <Button Content="انصراف" Click="Cancel_Click" Width="90" Padding="12,9"/>
        </StackPanel>
    </Grid>
</Window>
