<UserControl x:Class="Tarazpad.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid FlowDirection="RightToLeft">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
        <Border Background="White" BorderBrush="#E6EBF2" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,7,0">
            <StackPanel>
                <TextBlock Text="تنظیمات کلاینت ویندوز" FontSize="17" FontWeight="Bold"/>
                <TextBlock Text="این تنظیمات فقط نحوه اتصال برنامه نصب‌شده به سرور داخلی را کنترل می‌کند." Foreground="#7C899B" FontSize="11" Margin="0,6,0,22"/>
                <TextBlock Text="آدرس سرور داخلی" FontWeight="SemiBold" FontSize="11"/>
                <TextBox x:Name="ServerBox" Height="40" Margin="0,7,0,0" FlowDirection="LeftToRight"/>
                <TextBlock Text="نمونه: http://192.168.1.10:8080" Foreground="#94A3B8" FontSize="10" Margin="0,5,0,18"/>
                <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                    <Button x:Name="TestButton" Content="تست اتصال" Width="110" Style="{StaticResource SecondaryButton}" Click="TestButton_Click"/>
                    <Button x:Name="SaveButton" Content="ذخیره تنظیمات" Width="125" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="11"/>
                <Border Background="#F5F8FC" CornerRadius="10" Padding="15" Margin="0,24,0,0">
                    <StackPanel>
                        <TextBlock Text="مسیر تنظیمات روی ویندوز" Foreground="#64748B" FontSize="10"/>
                        <TextBlock x:Name="ConfigPathText" FlowDirection="LeftToRight" HorizontalAlignment="Right" Foreground="#334155" FontSize="10" Margin="0,7,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="#0E2A4A" CornerRadius="12" Padding="22" Margin="7,0,0,0">
            <StackPanel>
                <TextBlock Text="وضعیت محیط اجرا" Foreground="White" FontSize="17" FontWeight="Bold"/>
                <TextBlock Text="نسخه کلاینت" Foreground="#9DB3CC" FontSize="10" Margin="0,22,0,0"/><TextBlock Text="2.0.0 • Native WPF x64" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0" FlowDirection="LeftToRight"/>
                <TextBlock Text="حالت اجرا" Foreground="#9DB3CC" FontSize="10" Margin="0,20,0,0"/><TextBlock x:Name="RuntimeModeText" Text="—" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0"/>
                <TextBlock Text="دیتابیس" Foreground="#9DB3CC" FontSize="10" Margin="0,20,0,0"/><TextBlock x:Name="DatabaseText" Text="—" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0"/>
                <TextBlock Text="نیاز به اینترنت برای عملیات داخلی" Foreground="#9DB3CC" FontSize="10" Margin="0,20,0,0"/><TextBlock x:Name="InternetText" Text="—" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0"/>
                <Border Background="#173B62" CornerRadius="9" Padding="13" Margin="0,24,0,0"><TextBlock Text="کاربر نهایی برای اجرای ترازپاد نیازی به مرورگر ندارد. تمام صفحات اصلی در پنجره Native ویندوز اجرا می‌شوند." Foreground="#D9E8F7" TextWrapping="Wrap" LineHeight="21" FontSize="10"/></Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
